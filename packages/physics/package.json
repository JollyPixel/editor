{
  "name": "@jolly-pixel/physics",
  "description": "Engine-neutral physics contract and JollyPixel engine components",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "prepublishOnly": "tsc -b",
    "build": "tsc -b",
    "test-only": "node --test --test-isolation=none \"test/**/*.spec.ts\"",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit -p test/tsconfig.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/physics"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "@jolly-pixel/engine": "workspace:*",
    "three": "^0.186.0"
  },
  "peerDependenciesMeta": {
    "@jolly-pixel/engine": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jolly-pixel/engine": "workspace:*",
    "@jolly-pixel/loop": "workspace:*"
  }
}
