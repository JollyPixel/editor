{
  "name": "@jolly-pixel/engine",
  "description": "Minimal and opinionated actor/component framework with a renderer-agnostic core and a three.js backend.",
  "version": "7.1.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    }
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsc -b && node scripts/copyAssets.ts",
    "bake:environment": "node scripts/bakeRoomEnvironment.ts",
    "test-only": "node --test --test-isolation=none test/**/*.spec.ts",
    "test-gpu": "node --test test/systems/rendering/compositing/postProcessing.gpu.ts",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only",
    "lint": "oxlint src test scripts",
    "bench": "jolly-bench",
    "typecheck": "tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p bench/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/engine"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@jolly-pixel/asset": "workspace:*",
    "@jolly-pixel/controls": "workspace:*",
    "@jolly-pixel/loop": "workspace:*",
    "@openally/emitt": "1.1.0"
  },
  "devDependencies": {
    "@jolly-pixel/bench": "workspace:*"
  },
  "peerDependencies": {
    "three": "^0.187.0"
  }
}
