{
  "name": "@jolly-pixel/engine",
  "description": "Minimal and opiniated ECS framework on top of three.js.",
  "version": "5.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prepublishOnly": "rimraf ./dist && tsc -b",
    "build": "tsc -b",
    "test-only": "node --test test/**/*.spec.ts",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit -p test/tsconfig.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/engine"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@jolly-pixel/asset": "workspace:*",
    "@jolly-pixel/controls": "workspace:*",
    "@jolly-pixel/loop": "workspace:*",
    "@openally/emitt": "1.0.1",
    "picomatch": "4.0.7",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.2"
  },
  "peerDependencies": {
    "three": "^0.186.0"
  }
}
