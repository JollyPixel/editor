{
  "name": "@jolly-pixel/voxel.renderer",
  "description": "Jolly Pixel 3D Voxel Engine and Renderer",
  "version": "3.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./network/*.ts": "./dist/network/*.js",
    "./asset/*.ts": "./dist/asset/*.js",
    "./plugins/*": "./dist/plugins/*"
  },
  "scripts": {
    "prepublish": "rimraf ./dist && tsc -b",
    "build": "tsc",
    "dev": "vite",
    "test-only": "node --test \"test/**/*.spec.ts\"",
    "bench": "node --max-old-space-size=8192 bench/mesh-build.bench.ts",
    "bench:compare": "node --max-old-space-size=8192 bench/mesh-compare.bench.ts",
    "test": "c8 -r html npm run test-only",
    "clean": "rm -f cpu-profile-*.* heap-profile-*.*",
    "lint": "eslint src/**/*.ts"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/voxel-renderer"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@jolly-pixel/asset": "1.0.0",
    "@jolly-pixel/engine": "4.0.0",
    "@jolly-pixel/network": "1.1.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@dimforge/rapier3d": "0.20.0",
    "@jolly-pixel/loop": "1.0.0",
    "@jolly-pixel/runtime": "4.0.0",
    "@jolly-pixel/ui": "1.0.1",
    "simplex-noise": "4.0.3"
  },
  "peerDependencies": {
    "@jolly-pixel/asset-server": "1.0.0",
    "@jolly-pixel/event-store": "2.0.0"
  },
  "peerDependenciesMeta": {
    "@jolly-pixel/asset-server": {
      "optional": true
    },
    "@jolly-pixel/event-store": {
      "optional": true
    }
  }
}
