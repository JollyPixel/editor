{
  "name": "@jolly-pixel/voxel.renderer",
  "description": "Jolly Pixel 3D Voxel Engine and Renderer",
  "version": "5.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugins/engine/index.ts": {
      "types": "./dist/plugins/engine/index.d.ts",
      "default": "./dist/plugins/engine/index.js"
    },
    "./plugins/tiled/asset.ts": {
      "types": "./dist/plugins/tiled/asset.d.ts",
      "default": "./dist/plugins/tiled/asset.js"
    },
    "./plugins/tiled/index.ts": {
      "types": "./dist/plugins/tiled/index.d.ts",
      "default": "./dist/plugins/tiled/index.js"
    },
    "./plugins/*": "./dist/plugins/*"
  },
  "scripts": {
    "prepublishOnly": "tsc -b",
    "build": "tsc -b",
    "dev": "vite",
    "test-only": "node --test \"test/**/*.spec.ts\"",
    "test-gpu": "node --test test/render/transparency.gpu.ts",
    "bench": "node --max-old-space-size=8192 bench/mesh-build.bench.ts",
    "bench:compare": "node --max-old-space-size=8192 bench/mesh-compare.bench.ts",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only && pnpm run test-types",
    "clean": "rm -f cpu-profile-*.* heap-profile-*.*",
    "lint": "oxlint src test",
    "test-types": "tsc -p test/tsconfig.json && tstyche",
    "typecheck": "tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p bench/tsconfig.json && tsc --noEmit -p examples/tsconfig.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/voxel-renderer"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@openally/emitt": "1.1.0",
    "three": "0.186.0"
  },
  "peerDependencies": {
    "@jolly-pixel/asset": "workspace:*",
    "@jolly-pixel/engine": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@jolly-pixel/asset": {
      "optional": true
    },
    "@jolly-pixel/engine": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dimforge/rapier3d": "0.20.0",
    "@jolly-pixel/asset": "workspace:*",
    "@jolly-pixel/asset-source": "workspace:*",
    "@jolly-pixel/engine": "workspace:*",
    "@jolly-pixel/loop": "workspace:*",
    "@jolly-pixel/runtime": "workspace:*",
    "@jolly-pixel/ui": "workspace:*",
    "simplex-noise": "4.0.3"
  }
}
