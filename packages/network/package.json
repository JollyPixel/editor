{
  "name": "@jolly-pixel/network",
  "description": "The shared wire for JollyPixel's multiplayer editors",
  "version": "6.0.0",
  "type": "module",
  "sideEffects": [
    "./dist/server/extension/worker/WorkerExtensionHost.js"
  ],
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "scripts": {
    "prepublishOnly": "tsc -b",
    "build": "tsc -b",
    "build:schemas": "node scripts/compileSchemas.ts",
    "test-only": "node --import ./test/setup.ts --test \"test/**/*.spec.ts\"",
    "test-types": "tstyche --tsconfig ./test/tsconfig.json",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only && pnpm run test-types",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/network"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@jolly-pixel/history": "workspace:*",
    "@loglayer/transport-pino": "3.3.0",
    "@openally/emitt": "1.1.0",
    "@openally/mutex": "4.0.0",
    "@openally/result": "3.1.0",
    "ata-validator": "1.27.1",
    "hyperid": "4.0.0",
    "loglayer": "9.4.0",
    "pino": "10.3.1",
    "secure-json-parse": "4.1.0",
    "ts-pattern": "5.9.0",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/ws": "8.18.2",
    "fast-check": "4.10.2"
  }
}
