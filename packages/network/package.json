{
  "name": "@jolly-pixel/network",
  "description": "The shared wire for JollyPixel's multiplayer editors",
  "version": "1.0.0",
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugins/*.ts": "./dist/plugins/*.js",
    "./transport/*.ts": "./dist/transport/*.js",
    "./client": "./dist/client/index.js"
  },
  "scripts": {
    "prepublish": "rimraf ./dist && tsc -b",
    "build": "tsc",
    "test-only": "node --test \"test/**/*.spec.ts\"",
    "test": "c8 -r html npm run test-only"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/network"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@jolly-pixel/event-store": "1.0.0",
    "@loglayer/transport-pino": "3.3.0",
    "@openally/emitt": "1.0.1",
    "@openally/result": "3.0.0",
    "hyperid": "4.0.0",
    "loglayer": "9.4.0",
    "pino": "10.3.1",
    "ts-pattern": "5.9.0",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "vite": "8.2.0"
  }
}
