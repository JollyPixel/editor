{
  "name": "@jolly-pixel/golem.kit",
  "description": "The contract an asset package implements to give golems intent methods for its kind",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/golem-kit"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@jolly-pixel/asset-server": "workspace:*",
    "@jolly-pixel/history": "workspace:*",
    "@jolly-pixel/network": "workspace:*",
    "zod": "4.6.7"
  }
}
