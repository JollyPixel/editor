{
  "name": "@jolly-pixel/pixel-draw.renderer",
  "description": "Jolly Pixel Pixel Art drawer and renderer",
  "version": "6.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "prepublishOnly": "tsc -b",
    "build": "tsc -b",
    "bench": "jolly-bench --ignore browser.bench.ts",
    "bench:browser": "node bench/browser.bench.ts",
    "test-only": "node --import ./test/setup.ts --test \"test/**/*.spec.ts\"",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p bench/tsconfig.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/pixel-draw-renderer"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@jolly-pixel/asset-source": "workspace:*",
    "@jolly-pixel/bench": "workspace:*"
  },
  "dependencies": {
    "@jolly-pixel/color": "workspace:*",
    "@jolly-pixel/image": "workspace:*",
    "@openally/emitt": "1.0.1",
    "js-base64": "3.9.3"
  }
}
