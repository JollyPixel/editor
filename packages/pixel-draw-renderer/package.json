{
  "name": "@jolly-pixel/pixel-draw.renderer",
  "description": "Jolly Pixel Pixel Art drawer and renderer",
  "version": "3.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./network/*.ts": "./dist/network/*.js",
    "./asset/*.ts": "./dist/asset/*.js"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "prepublish": "rimraf ./dist && tsc -b",
    "build": "tsc",
    "bench": "jolly-bench --ignore browser.bench.ts",
    "bench:browser": "node bench/browser.bench.ts",
    "test-only": "node --import ./test/setup.ts --test \"test/**/*.spec.ts\"",
    "test": "c8 -r html npm run test-only",
    "lint": "eslint src/**/*.ts"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/pixel-draw-renderer"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@jolly-pixel/bench": "*"
  },
  "dependencies": {
    "@jolly-pixel/color": "1.0.0",
    "@jolly-pixel/image": "1.0.0",
    "@jolly-pixel/network": "1.1.0",
    "@openally/emitt": "1.0.1",
    "js-base64": "3.9.3"
  },
  "peerDependencies": {
    "@jolly-pixel/asset-server": "1.0.0",
    "@jolly-pixel/event-store": "2.0.0"
  },
  "peerDependenciesMeta": {
    "@jolly-pixel/asset-server": {
      "optional": true
    },
    "@jolly-pixel/event-store": {
      "optional": true
    }
  }
}
