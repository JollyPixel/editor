{
  "name": "@jolly-pixel/ui",
  "description": "Common and System's UI for JollyPixel's editors",
  "version": "1.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./feedback": {
      "types": "./dist/feedback/index.d.ts",
      "default": "./dist/feedback/index.js"
    },
    "./stats": {
      "types": "./dist/stats/index.d.ts",
      "default": "./dist/stats/index.js"
    },
    "./icon": {
      "types": "./dist/icon/index.d.ts",
      "default": "./dist/icon/index.js"
    }
  },
  "scripts": {
    "prepublish": "rimraf ./dist ./tsconfig.tsbuildinfo && tsc -b",
    "build": "tsc",
    "dev": "vite",
    "test-only": "node --import ./test/setup.ts --test \"test/**/*.spec.ts\"",
    "test": "c8 -r html npm run test-only",
    "test:e2e": "playwright test"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/ui"
  },
  "keywords": [],
  "files": [
    "dist",
    "NOTICE"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "lit": "^3.3.0"
  },
  "dependencies": {
    "@jolly-pixel/resize-handle": "1.2.0"
  },
  "devDependencies": {
    "lit": "3.3.3"
  }
}
