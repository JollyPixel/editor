{
  "name": "@jolly-pixel/ui",
  "description": "Common and System's UI for JollyPixel's editors",
  "version": "3.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./feedback": {
      "types": "./dist/feedback/index.d.ts",
      "default": "./dist/feedback/index.js"
    },
    "./network": {
      "types": "./dist/network/index.d.ts",
      "default": "./dist/network/index.js"
    },
    "./stats": {
      "types": "./dist/stats/index.d.ts",
      "default": "./dist/stats/index.js"
    },
    "./icon": {
      "types": "./dist/icon/index.d.ts",
      "default": "./dist/icon/index.js"
    }
  },
  "scripts": {
    "prepublishOnly": "tsc -b",
    "build": "tsc -b",
    "dev": "vite",
    "test-only": "node --import ./test/setup.ts --test \"test/**/*.spec.ts\"",
    "test-types": "tstyche --tsconfig ./test/tsconfig.json",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only && pnpm run test-types",
    "test:e2e": "playwright test",
    "lint": "oxlint src test examples && pnpm run lint:css",
    "lint:css": "stylelint \"src/**/*.ts\" \"examples/**/*.{ts,css}\" --cache",
    "typecheck": "tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p examples/tsconfig.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/ui"
  },
  "keywords": [],
  "files": [
    "dist",
    "NOTICE"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "@jolly-pixel/network": "workspace:^",
    "lit": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "@jolly-pixel/network": {
      "optional": true
    }
  },
  "dependencies": {
    "@jolly-pixel/color": "workspace:*",
    "@jolly-pixel/resize-handle": "workspace:*"
  },
  "devDependencies": {
    "@jolly-pixel/e2e": "workspace:*",
    "@jolly-pixel/network": "workspace:*",
    "lit": "3.3.3"
  }
}
