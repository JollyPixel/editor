+    }
+    else {
+      const observer = new MutationObserver(() => {
+        if (document.documentElement.dataset.editorState === "ready") {
+          observer.disconnect();
+          release();
+        }
+      });
+      observer.observe(document.documentElement, { attributes: true, attributeFilter: ["data-editor-state"] });
+    }
+  }
+
+  return false;
+}
