+function benchLibraryAllowed(
+  wake: () => void
+): boolean {
+  let flag: string | null = null;
+  try {
+    flag = localStorage.getItem("bench:defer-library");
+  }
+  catch {
+    flag = null;
+  }
+  if (flag !== "1" && flag !== "off") {
