{
  "name": "@jolly-pixel/studio",
  "description": "JollyPixel studio: one project, its assets and one editor per tab",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "files": [
    "dist",
    "public",
    "node",
    "shared",
    "src"
  ],
  "scripts": {
    "build": "pnpm --filter @jolly-pixel/editor.pixel-art build:page",
    "build:deps": "pnpm --filter \"@jolly-pixel/studio^...\" --filter \"{../assets/*}...\" --filter \"{../editors/*}...\" run build",
    "build:static": "vite build --mode static",
    "build:hosted": "vite build",
    "dev:e2e": "vite --mode e2e",
    "dev": "vite",
    "start": "node --env-file-if-exists=.env node/start.ts",
    "dev:editors": "pnpm --parallel --filter @jolly-pixel/ui --filter @jolly-pixel/editor.host --filter @jolly-pixel/editor.pixel-art run build:watch",
    "test-only": "node --import ./test/setup.ts --test \"test/**/*.spec.ts\"",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only",
    "test:e2e": "playwright test",
    "perf:open": "node perf/open/measure.ts",
    "perf:ab": "node perf/open/ab.ts",
    "perf:summary": "node perf/open/summarize.ts",
    "typecheck": "tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p node/tsconfig.json && tsc --noEmit -p shared/tsconfig.json && tsc --noEmit -p vite/tsconfig.json && tsc --noEmit -p perf/tsconfig.json",
    "lint": "oxlint src shared node test vite perf vite.config.ts && pnpm run lint:css",
    "lint:css": "stylelint \"public/**/*.css\" --cache"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/studio"
  },
  "keywords": [],
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@jolly-pixel/cdp": "workspace:*",
    "@jolly-pixel/e2e": "workspace:*",
    "@openally/servo": "1.1.0"
  },
  "dependencies": {
    "@jolly-pixel/accounts": "workspace:*",
    "@jolly-pixel/asset": "workspace:*",
    "@jolly-pixel/asset-server": "workspace:*",
    "@jolly-pixel/asset.pixel-art": "workspace:*",
    "@jolly-pixel/asset.voxel-map": "workspace:*",
    "@jolly-pixel/asset.voxel-model": "workspace:*",
    "@jolly-pixel/controls": "workspace:*",
    "@jolly-pixel/editor.host": "workspace:*",
    "@jolly-pixel/editor.script": "workspace:*",
    "@jolly-pixel/engine": "workspace:*",
    "@jolly-pixel/network": "workspace:*",
    "@jolly-pixel/physics": "workspace:*",
    "@jolly-pixel/physics.rapier": "workspace:*",
    "@jolly-pixel/pixel-draw.renderer": "workspace:*",
    "@jolly-pixel/preferences": "workspace:*",
    "@jolly-pixel/runtime": "workspace:*",
    "@jolly-pixel/server": "workspace:*",
    "@jolly-pixel/three": "workspace:*",
    "@jolly-pixel/ui": "workspace:*",
    "@jolly-pixel/utils": "workspace:*",
    "@jolly-pixel/voxel.renderer": "workspace:*",
    "lit": "3.3.3",
    "three": "0.186.1",
    "zod": "4.6.7"
  }
}
