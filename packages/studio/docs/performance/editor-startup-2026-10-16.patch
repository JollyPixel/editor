+async function prefetchEditors(
+  manifest: ProjectManifest
+): Promise<void> {
+  await Promise.all(manifest.editors.map(async({ name }) => {
+    const page = new URL(`editors/${name}/`, document.baseURI);
+    const html = await (await fetch(page)).text();
+    const files = html.matchAll(/(?:src|href)="\.\/([^"]+\.(?:js|css))"/g);
+    await Promise.all(
+      Array.from(files, async([, file]) => {
+        const response = await fetch(new URL(file, page), { priority: "low" });
+        await response.arrayBuffer();
+      })
+    );
+  }));
+}
