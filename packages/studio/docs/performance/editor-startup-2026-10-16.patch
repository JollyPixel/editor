+
+class LazyKtx2Loader {
+  #loader: Promise<KTX2Loader> | null = null;
+  #create: () => Promise<KTX2Loader>;
+
+  constructor(
+    manager: THREE.LoadingManager,
+    transcoderPath: string,
+    renderer: THREE.WebGPURenderer
+  ) {
+    this.#create = async() => {
+      const { KTX2Loader } = await import("three/addons/loaders/KTX2Loader.js");
+
+      return new KTX2Loader(manager)
+        .setTranscoderPath(transcoderPath)
+        .detectSupport(renderer);
+    };
+  }
+
+  async loadAsync(
+    url: string
+  ): Promise<THREE.CompressedTexture> {
+    this.#loader ??= this.#create();
+
+    return (await this.#loader).loadAsync(url);
+  }
+
+  dispose(): void {
+    void this.#loader?.then((loader) => loader.dispose());
+  }
+}
