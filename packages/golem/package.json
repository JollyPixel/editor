{
  "name": "@jolly-pixel/golem",
  "description": "Connects a local AI agent to a running JollyPixel studio as a peer",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "bin": {
    "jolly-golem": "./dist/bin/jolly-golem.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/GolemMcpServer.d.ts",
      "default": "./dist/mcp/GolemMcpServer.js"
    }
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "build": "tsc -b",
    "test-only": "node --test --test-isolation=none \"test/**/*.spec.ts\"",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only",
    "lint": "oxlint src test skill",
    "typecheck": "tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p skill/examples/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/golem"
  },
  "keywords": [],
  "files": [
    "dist",
    "skill"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@jolly-pixel/accounts": "workspace:*",
    "@jolly-pixel/asset": "workspace:*",
    "@jolly-pixel/asset-server": "workspace:*",
    "@jolly-pixel/asset.pixel-art": "workspace:*",
    "@jolly-pixel/asset.scene": "workspace:*",
    "@jolly-pixel/asset.script": "workspace:*",
    "@jolly-pixel/asset.voxel-map": "workspace:*",
    "@jolly-pixel/asset.voxel-model": "workspace:*",
    "@jolly-pixel/color": "workspace:*",
    "@jolly-pixel/history": "workspace:*",
    "@jolly-pixel/network": "workspace:*",
    "@jolly-pixel/pixel-draw.renderer": "workspace:*",
    "@jolly-pixel/server": "workspace:*",
    "@jolly-pixel/voxel.renderer": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0"
  }
}
