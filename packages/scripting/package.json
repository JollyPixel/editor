{
  "name": "@jolly-pixel/scripting",
  "description": "Compiles, checks, outlines, links and loads JollyPixel scripts and shaders",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./three": {
      "types": "./dist/three.d.ts",
      "default": "./dist/three.js"
    },
    "./language": {
      "types": "./dist/language/ScriptLanguageService.d.ts",
      "default": "./dist/language/ScriptLanguageService.js"
    },
    "./types": {
      "types": "./dist/types/scriptTypes.d.ts",
      "default": "./dist/types/scriptTypes.js"
    }
  },
  "imports": {
    "#src/*": "./src/*",
    "#compiler": {
      "browser": "./dist/compiler/browser.js",
      "default": "./dist/compiler/node.js"
    },
    "#outliner": {
      "browser": "./dist/outline/outliner/browser.js",
      "default": "./dist/outline/outliner/node.js"
    },
    "#stripper": {
      "browser": "./dist/compiler/stripper/browser.js",
      "default": "./dist/compiler/stripper/node.js"
    },
    "#linter": {
      "browser": "./dist/lint/linter/browser.js",
      "default": "./dist/lint/linter/node.js"
    }
  },
  "scripts": {
    "build": "node ../../node_modules/typescript7/bin/tsc -b && node scripts/bundleTypes.ts",
    "test-only": "node --test --test-isolation=none \"test/**/*.spec.ts\"",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only",
    "lint": "oxlint src test",
    "typecheck": "node ../../node_modules/typescript7/bin/tsc --noEmit -p test/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/scripting"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "directories": {
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@jolly-pixel/asset": "workspace:*",
    "@jolly-pixel/backend.three": "workspace:*",
    "@jolly-pixel/ecs": "workspace:*",
    "@jolly-pixel/network": "workspace:*",
    "@jolly-pixel/utils": "workspace:*",
    "@swc/wasm-typescript-esm": "1.16.22",
    "es-module-lexer": "3.0.4",
    "oxlint": "1.93.0",
    "three": "0.187.0",
    "ts-morph": "28.0.0",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  }
}
