{
  "name": "@jolly-pixel/asset-server",
  "description": "Back-end asset orchestration: event-sourced projection, reconciliation and catalog delivery",
  "version": "4.0.0",
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/catalog/client/index.d.ts",
      "default": "./dist/catalog/client/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "scripts": {
    "prepublishOnly": "tsc -b",
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p test/tsconfig.json",
    "test-only": "node --test \"test/**/*.spec.ts\"",
    "test-types": "tstyche --tsconfig ./test/tsconfig.json",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only && pnpm run test-types",
    "lint": "oxlint src test"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/asset-server"
  },
  "keywords": [],
  "files": [
    "dist",
    "docs"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@jolly-pixel/asset": "workspace:*",
    "@jolly-pixel/asset-source": "workspace:*",
    "@jolly-pixel/event-store": "workspace:*",
    "@jolly-pixel/network": "workspace:*",
    "@openally/emitt": "1.1.0",
    "@openally/result": "3.1.0",
    "@openally/servo": "1.1.0",
    "ata-validator": "1.27.1",
    "fflate": "0.8.3",
    "js-base64": "3.9.3",
    "loglayer": "9.4.0",
    "picomatch": "4.0.7"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
