{
  "name": "@jolly-pixel/editor.pixel-art",
  "description": "Reusable pixel-art UI on top of @jolly-pixel/pixel-draw.renderer",
  "version": "1.1.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mesh-texturing/*.ts": "./dist/mesh-texturing/*.js",
    "./change-tracking/*.ts": "./dist/change-tracking/*.js"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "prepublishOnly": "rimraf ./dist && tsc -b",
    "build": "tsc -b",
    "dev": "vite",
    "test-only": "node --import ./test/setup.ts --test \"test/**/*.spec.ts\"",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only",
    "test:e2e": "playwright test",
    "lint": "oxlint src test && pnpm run lint:css",
    "lint:css": "stylelint \"src/**/*.ts\" \"examples/scripts/**/*.ts\" \"examples/public/**/*.css\" --cache",
    "typecheck": "tsc --noEmit -p test/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/editors/pixel-art"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@jolly-pixel/asset": "workspace:*",
    "@jolly-pixel/asset-server": "workspace:*",
    "@jolly-pixel/asset-source": "workspace:*",
    "@jolly-pixel/engine": "workspace:*",
    "@jolly-pixel/event-store": "workspace:*",
    "@jolly-pixel/runtime": "workspace:*"
  },
  "dependencies": {
    "@jolly-pixel/asset.pixel-art": "workspace:*",
    "@jolly-pixel/color": "workspace:*",
    "@jolly-pixel/image": "workspace:*",
    "@jolly-pixel/network": "workspace:*",
    "@jolly-pixel/pixel-draw.renderer": "workspace:*",
    "@jolly-pixel/ui": "workspace:*",
    "@openally/emitt": "1.0.1",
    "lit": "3.3.3",
    "three": "0.186.0"
  }
}
