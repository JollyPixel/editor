{
  "name": "@jolly-pixel/editor.pixel-art",
  "description": "Reusable pixel-art UI on top of @jolly-pixel/pixel-draw.renderer",
  "version": "1.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "prepublish": "rimraf ./dist && tsc -b",
    "build": "tsc",
    "dev": "vite",
    "test-only": "node --import ./test/setup.ts --test \"test/**/*.spec.ts\"",
    "test": "c8 -r html npm run test-only",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/editors/pixel-art"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@jolly-pixel/engine": "4.0.0",
    "@jolly-pixel/resize-handle": "1.1.0",
    "@jolly-pixel/runtime": "4.0.0",
    "three": "0.185.1"
  },
  "dependencies": {
    "@jolly-pixel/network": "1.1.0",
    "@jolly-pixel/pixel-draw.renderer": "3.0.0",
    "lit": "3.3.3",
    "vanilla-picker": "2.12.3"
  }
}
