{
  "name": "@jolly-pixel/editor.script",
  "description": "Collaborative editor for JollyPixel script assets",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "jollypixel": {
    "editor": {
      "name": "script",
      "kinds": [
        "script",
        "text",
        "shader"
      ],
      "page": "index.html"
    },
    "scene": "./scene",
    "sceneComponents": {
      "Script": {
        "assets": {
          "script": "script"
        }
      }
    },
    "runtime": "./runtime"
  },
  "exports": {
    ".": "./src/scene/index.ts",
    "./scene": "./src/scene/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./markdown": "./src/markdown/MarkdownView.ts"
  },
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --mode e2e",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "test-only": "node --test --test-isolation=none \"test/**/*.spec.ts\"",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p bench/tsconfig.json",
    "lint": "oxlint src test bench vite.config.ts playwright.config.ts && pnpm run lint:css",
    "bench": "jolly-bench",
    "lint:css": "stylelint \"src/**/*.ts\" \"public/**/*.css\" --cache"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/editors/script"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "imports": {
    "#src/*": "./src/*"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@jolly-pixel/bench": "workspace:*",
    "@jolly-pixel/e2e": "workspace:*"
  },
  "dependencies": {
    "@jolly-pixel/asset": "workspace:*",
    "@jolly-pixel/asset-server": "workspace:*",
    "@jolly-pixel/asset.script": "workspace:*",
    "@jolly-pixel/editor.host": "workspace:*",
    "@jolly-pixel/engine": "workspace:*",
    "@jolly-pixel/network": "workspace:*",
    "@jolly-pixel/runtime": "workspace:*",
    "@jolly-pixel/scripting": "workspace:*",
    "@jolly-pixel/ui": "workspace:*",
    "@jolly-pixel/utils": "workspace:*",
    "@openally/emitt": "1.1.0",
    "dompurify": "3.4.17",
    "lit": "3.3.3",
    "marked": "16.4.2",
    "sugar-high": "2.6.4",
    "three": "0.186.1",
    "zod": "4.6.7"
  }
}
