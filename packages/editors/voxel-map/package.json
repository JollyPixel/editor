{
  "name": "@jolly-pixel/editor.voxel-map",
  "description": "Collaborative voxel-map editor for JollyPixel",
  "version": "1.2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "prepublish": "rimraf ./dist && tsc -b",
    "build": "npm run typecheck && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test-only": "node --import ./test/setup.ts --test \"test/**/*.spec.ts\"",
    "test": "c8 -r html npm run test-only",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p vite/tsconfig.json",
    "lint": "eslint src/**/*.ts test/**/*.ts vite/**/*.ts vite.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/editors/voxel-map"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@jolly-pixel/asset": "1.0.0",
    "@jolly-pixel/asset-server": "1.0.0",
    "@jolly-pixel/color": "1.0.0",
    "@jolly-pixel/editor.pixel-art": "1.1.0",
    "@jolly-pixel/engine": "4.0.0",
    "@jolly-pixel/event-store": "2.0.0",
    "@jolly-pixel/network": "1.1.0",
    "@jolly-pixel/pixel-draw.renderer": "3.0.0",
    "@jolly-pixel/resize-handle": "1.1.0",
    "@jolly-pixel/runtime": "4.0.0",
    "@jolly-pixel/three": "1.1.0",
    "@jolly-pixel/ui": "1.0.1",
    "@jolly-pixel/voxel.renderer": "3.0.0",
    "lit": "3.3.3",
    "three": "0.185.1"
  }
}
