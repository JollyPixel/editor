{
  "name": "@jolly-pixel/editor.voxel-map",
  "description": "Collaborative voxel-map editor for JollyPixel",
  "version": "1.2.0",
  "type": "module",
  "private": true,
  "jollypixel": {
    "editor": {
      "name": "voxel-map",
      "kinds": [
        "voxelmap"
      ]
    }
  },
  "scripts": {
    "prepublishOnly": "rimraf ./dist && tsc -b",
    "build": "pnpm run typecheck && vite build",
    "build:static": "pnpm run typecheck && vite build --mode static",
    "dev": "vite",
    "dev:e2e": "vite --mode e2e",
    "preview": "vite preview",
    "test-only": "node --import ./test/setup.ts --test \"test/**/*.spec.ts\"",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p test/tsconfig.json",
    "lint": "oxlint src test vite.config.ts playwright.config.ts && pnpm run lint:css",
    "lint:css": "stylelint \"src/**/*.ts\" \"public/**/*.css\" --cache"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/editors/voxel-map"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@jolly-pixel/asset-source": "workspace:*",
    "@jolly-pixel/e2e": "workspace:*"
  },
  "dependencies": {
    "@jolly-pixel/asset": "workspace:*",
    "@jolly-pixel/asset-server": "workspace:*",
    "@jolly-pixel/asset.pixel-art": "workspace:*",
    "@jolly-pixel/asset.voxel-map": "workspace:*",
    "@jolly-pixel/color": "workspace:*",
    "@jolly-pixel/controls": "workspace:*",
    "@jolly-pixel/editor.host": "workspace:*",
    "@jolly-pixel/editor.pixel-art": "workspace:*",
    "@jolly-pixel/engine": "workspace:*",
    "@jolly-pixel/event-store": "workspace:*",
    "@jolly-pixel/network": "workspace:*",
    "@jolly-pixel/pixel-draw.renderer": "workspace:*",
    "@jolly-pixel/resize-handle": "workspace:*",
    "@jolly-pixel/runtime": "workspace:*",
    "@jolly-pixel/three": "workspace:*",
    "@jolly-pixel/ui": "workspace:*",
    "@jolly-pixel/voxel.renderer": "workspace:*",
    "@openally/emitt": "1.1.0",
    "lit": "3.3.3",
    "three": "0.186.0"
  }
}
