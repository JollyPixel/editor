{
  "name": "@jolly-pixel/editor.model",
  "description": "Read-only 3D model viewer for JollyPixel model assets",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "jollypixel": {
    "editor": {
      "name": "model",
      "kinds": [
        "model"
      ],
      "page": "index.html"
    },
    "scene": "./scene",
    "runtime": "./runtime",
    "preview": ["model"]
  },
  "exports": {
    ".": "./src/sceneComponents/index.ts",
    "./scene": "./src/sceneComponents/index.ts",
    "./runtime": "./src/runtime/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "test-only": "node --test --test-isolation=none \"test/**/*.spec.ts\"",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only",
    "typecheck": "tsc --noEmit -p test/tsconfig.json",
    "lint": "oxlint src test vite.config.ts && pnpm run lint:css",
    "lint:css": "stylelint \"src/**/*.ts\" \"public/**/*.css\" --cache"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/editors/model"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "imports": {
    "#src/*": "./src/*"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@jolly-pixel/e2e": "workspace:*"
  },
  "dependencies": {
    "@jolly-pixel/asset": "workspace:*",
    "@jolly-pixel/asset-server": "workspace:*",
    "@jolly-pixel/asset.model": "workspace:*",
    "@jolly-pixel/editor.host": "workspace:*",
    "@jolly-pixel/engine": "workspace:*",
    "@jolly-pixel/preferences": "workspace:*",
    "@jolly-pixel/runtime": "workspace:*",
    "@jolly-pixel/three": "workspace:*",
    "@jolly-pixel/ui": "workspace:*",
    "@jolly-pixel/utils": "workspace:*",
    "@openally/emitt": "1.1.0",
    "lit": "3.3.3",
    "three": "0.187.0"
  }
}
