{
  "name": "@jolly-pixel/editor.voxel-model",
  "version": "1.0.3",
  "type": "module",
  "private": true,
  "jollypixel": {
    "editor": {
      "name": "voxel-model",
      "kinds": [
        "voxelmodel"
      ]
    }
  },
  "scripts": {
    "prepublishOnly": "rimraf ./dist && tsc -b",
    "dev": "vite",
    "dev:e2e": "vite --mode e2e",
    "build": "vite build",
    "build:static": "pnpm run typecheck && vite build --mode static",
    "preview": "vite preview",
    "test-only": "node --import ./test/setup.ts --test \"test/**/*.spec.ts\"",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p vite/tsconfig.json",
    "lint": "oxlint src test vite vite.config.ts playwright.config.ts && pnpm run lint:css",
    "lint:css": "stylelint \"src/**/*.ts\" \"public/**/*.css\" --cache"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "imports": {
    "#src/*": "./src/*"
  },
  "devDependencies": {
    "@jolly-pixel/asset-source": "workspace:*",
    "@jolly-pixel/e2e": "workspace:*",
    "@jolly-pixel/event-store": "workspace:*"
  },
  "dependencies": {
    "@jolly-pixel/asset": "workspace:*",
    "@jolly-pixel/asset-server": "workspace:*",
    "@jolly-pixel/asset.pixel-art": "workspace:*",
    "@jolly-pixel/asset.voxel-model": "workspace:*",
    "@jolly-pixel/color": "workspace:*",
    "@jolly-pixel/editor.host": "workspace:*",
    "@jolly-pixel/editor.pixel-art": "workspace:*",
    "@jolly-pixel/engine": "workspace:*",
    "@jolly-pixel/network": "workspace:*",
    "@jolly-pixel/pixel-draw.renderer": "workspace:*",
    "@jolly-pixel/runtime": "workspace:*",
    "@jolly-pixel/three": "workspace:*",
    "@jolly-pixel/ui": "workspace:*",
    "@openally/emitt": "1.1.0",
    "lit": "3.3.3",
    "three": "0.186.0"
  }
}
