{
  "name": "@jolly-pixel/controls",
  "description": "Input controls (Screen, Mouse, Touchpad, Keyboard, Gamepad)",
  "version": "2.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prepublishOnly": "tsc -b",
    "build": "tsc -b",
    "test-only": "node --test \"test/**/*.spec.ts\"",
    "test-types": "tstyche --tsconfig ./test/tsconfig.json",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only && pnpm run test-types",
    "lint": "oxlint src test",
    "bench": "jolly-bench",
    "typecheck": "tsc --noEmit -p test/tsconfig.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/controls"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@openally/emitt": "1.0.1"
  },
  "devDependencies": {
    "@jolly-pixel/bench": "workspace:*"
  }
}
