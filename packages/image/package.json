{
  "name": "@jolly-pixel/image",
  "description": "PNG codecs and browser raster decoding",
  "version": "1.1.0",
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./raster": {
      "types": "./dist/raster/index.d.ts",
      "default": "./dist/raster/index.js"
    }
  },
  "scripts": {
    "prepublishOnly": "tsc -b",
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p bench/tsconfig.json",
    "test-only": "pnpm run test-only:node && pnpm run test-only:dom",
    "test-only:node": "node --test \"test/png/**/*.spec.ts\" \"test/*.spec.ts\"",
    "test-only:dom": "node --import ./test/setup.ts --test \"test/raster/**/*.spec.ts\"",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only",
    "lint": "oxlint src test",
    "bench": "jolly-bench"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/image"
  },
  "devDependencies": {
    "@jolly-pixel/bench": "workspace:*"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT"
}
