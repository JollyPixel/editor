{
  "name": "@jolly-pixel/three",
  "description": "Common Three.js utilities and components for JollyPixel's workspaces and editors",
  "version": "1.1.0",
  "type": "module",
  "exports": "./dist/index.js",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "prepublish": "rimraf ./dist && tsc -b",
    "build": "tsc",
    "test-only": "node --import ./test/setup.ts --test \"test/**/*.test.ts\"",
    "test": "c8 -r html npm run test-only",
    "dev": "vite"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/three"
  },
  "keywords": [],
  "files": [
    "dist",
    "docs"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@jolly-pixel/network": "1.1.0",
    "@tweakpane/core": "2.0.5",
    "tweakpane": "4.0.5"
  }
}
