{
  "name": "@jolly-pixel/three",
  "description": "Common Three.js utilities and components for JollyPixel's workspaces and editors",
  "version": "3.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./network": {
      "types": "./dist/network/index.d.ts",
      "default": "./dist/network/index.js"
    }
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "prepublish": "rimraf ./dist && tsc -b",
    "build": "tsc",
    "test-only": "node --import ./test/setup.ts --test \"test/**/*.test.ts\"",
    "test": "npm run typecheck && c8 -r html npm run test-only",
    "dev": "vite",
    "lint": "eslint src test examples",
    "typecheck": "tsc --noEmit -p test/tsconfig.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/three"
  },
  "keywords": [],
  "files": [
    "dist",
    "docs"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "@jolly-pixel/network": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@jolly-pixel/network": {
      "optional": true
    }
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@jolly-pixel/color": "1.0.0",
    "@jolly-pixel/network": "3.0.0",
    "@jolly-pixel/ui": "2.0.1"
  }
}
