{
  "name": "@jolly-pixel/three",
  "description": "Common Three.js utilities and components for JollyPixel's workspaces and editors",
  "version": "6.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./network": {
      "types": "./dist/network/index.d.ts",
      "default": "./dist/network/index.js"
    }
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsc -b",
    "test-only": "node --import ./test/setup.ts --test --test-isolation=none \"test/**/*.test.ts\"",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only",
    "dev": "vite",
    "lint": "oxlint src test examples",
    "typecheck": "tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p examples/tsconfig.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/three"
  },
  "keywords": [],
  "files": [
    "dist",
    "docs"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "@jolly-pixel/network": "workspace:^",
    "three": "^0.187.0"
  },
  "peerDependenciesMeta": {
    "@jolly-pixel/network": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jolly-pixel/color": "workspace:*",
    "@jolly-pixel/network": "workspace:*",
    "@jolly-pixel/ui": "workspace:*"
  }
}
