{
  "name": "@jolly-pixel/runtime",
  "description": "Jolly Pixel Runtime for web browsers and electron applications.",
  "version": "5.2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prepublishOnly": "tsc -b",
    "build": "tsc -b",
    "test-only": "node --test \"test/**/*.spec.ts\"",
    "test-types": "tstyche --tsconfig ./test/tsconfig.json",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only && pnpm run test-types",
    "dev": "vite",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p examples/tsconfig.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/runtime"
  },
  "keywords": [],
  "files": [
    "dist",
    "docs"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@jolly-pixel/asset": "workspace:*",
    "@jolly-pixel/engine": "workspace:*",
    "@jolly-pixel/loop": "workspace:*",
    "@jolly-pixel/ui": "workspace:*",
    "@pmndrs/detect-gpu": "6.0.22"
  },
  "peerDependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "electron": "44.4.2"
  }
}
