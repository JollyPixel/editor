{
  "name": "@jolly-pixel/loop",
  "description": "Frame scheduling and time primitives (FrameScheduler, GameLoop)",
  "version": "1.0.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prepublishOnly": "tsc -b",
    "build": "tsc -b",
    "test-only": "node --test \"test/**/*.spec.ts\"",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only",
    "lint": "oxlint src test",
    "bench": "jolly-bench",
    "dev": "vite",
    "typecheck": "tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p bench/tsconfig.json && tsc --noEmit -p examples/tsconfig.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/loop"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@openally/emitt": "1.1.0"
  },
  "devDependencies": {
    "@jolly-pixel/bench": "workspace:*",
    "@jolly-pixel/ui": "workspace:*"
  }
}
