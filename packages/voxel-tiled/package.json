{
  "name": "@jolly-pixel/voxel.tiled",
  "description": "Tiled map import for @jolly-pixel/voxel.renderer",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "vite",
    "test-only": "node --test \"test/**/*.spec.ts\"",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p examples/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/voxel-tiled"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "@jolly-pixel/asset": "workspace:*",
    "@jolly-pixel/engine": "workspace:*",
    "@jolly-pixel/voxel.renderer": "workspace:*",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@jolly-pixel/asset": "workspace:*",
    "@jolly-pixel/engine": "workspace:*",
    "@jolly-pixel/runtime": "workspace:*",
    "@jolly-pixel/voxel.renderer": "workspace:*",
    "three": "0.186.0"
  }
}
