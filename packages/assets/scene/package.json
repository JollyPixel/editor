{
  "name": "@jolly-pixel/asset.scene",
  "description": "Scene assets",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/network/client.d.ts",
      "default": "./dist/network/client.js"
    },
    "./server": {
      "types": "./dist/network/server.d.ts",
      "default": "./dist/network/server.js"
    }
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "build": "tsc -b",
    "test-only": "node --test \"test/**/*.spec.ts\"",
    "test-types": "tstyche --tsconfig ./test/tsconfig.json",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only && pnpm run test-types",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit -p test/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/assets/scene"
  },
  "keywords": [],
  "files": [
    "dist",
    "docs"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@jolly-pixel/asset": "workspace:*",
    "@jolly-pixel/asset-server": "workspace:*",
    "@jolly-pixel/history": "workspace:*",
    "@jolly-pixel/network": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@jolly-pixel/engine": "workspace:*"
  }
}
