{
  "name": "@jolly-pixel/asset.scene",
  "description": ".scene.json scenes",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/network/client.d.ts",
      "default": "./dist/network/client.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./server": {
      "types": "./dist/network/server.d.ts",
      "default": "./dist/network/server.js"
    },
    "./golem": {
      "types": "./dist/golem/index.d.ts",
      "default": "./dist/golem/index.js"
    }
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "jollypixel": {
    "golem": "./golem",
    "runtime": "./runtime",
    "sceneComponents": {
      "Camera": {},
      "Light": {},
      "Mesh": {
        "assets": {
          "shader": "shader"
        }
      },
      "Text": {
        "assets": {
          "font": "font"
        }
      },
      "RigidBody": {}
    }
  },
  "scripts": {
    "build": "tsc -b && node -e \"fs.cpSync('src/golem/guide.md', 'dist/golem/guide.md')\"",
    "test-only": "node --test --test-isolation=none \"test/**/*.spec.ts\"",
    "test-types": "tstyche --tsconfig ./test/tsconfig.json",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only && pnpm run test-types",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit -p test/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/assets/scene"
  },
  "keywords": [],
  "files": [
    "dist",
    "docs"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@jolly-pixel/asset": "workspace:*",
    "@jolly-pixel/asset-server": "workspace:*",
    "@jolly-pixel/asset.common": "workspace:*",
    "@jolly-pixel/backend.three": "workspace:*",
    "@jolly-pixel/golem.kit": "workspace:*",
    "@jolly-pixel/history": "workspace:*",
    "@jolly-pixel/network": "workspace:*",
    "@jolly-pixel/physics": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@jolly-pixel/backend.three": "workspace:*",
    "@jolly-pixel/ecs": "workspace:*"
  }
}
