{
  "name": "@jolly-pixel/asset.voxel-map",
  "description": "Jolly Pixel voxel-map persistence and collaboration",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./network/client.ts": {
      "types": "./dist/network/client.d.ts",
      "default": "./dist/network/client.js"
    },
    "./network/server.ts": {
      "types": "./dist/network/server.d.ts",
      "default": "./dist/network/server.js"
    }
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "prepublishOnly": "rimraf ./dist ./tsconfig.tsbuildinfo && tsc -b",
    "build": "tsc -b",
    "test-only": "node --test \"test/**/*.spec.ts\"",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit -p test/tsconfig.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/assets/voxel-map"
  },
  "keywords": [],
  "files": [
    "dist",
    "docs"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@jolly-pixel/asset-server": "workspace:*",
    "@jolly-pixel/asset.pixel-art": "workspace:*",
    "@jolly-pixel/network": "workspace:*",
    "@jolly-pixel/voxel.renderer": "workspace:*"
  },
  "devDependencies": {
    "@jolly-pixel/asset": "workspace:*",
    "@jolly-pixel/asset-source": "workspace:*",
    "@jolly-pixel/event-store": "workspace:*"
  }
}
