{
  "name": "@jolly-pixel/asset.voxel-map",
  "description": ".voxelmap.json worlds and the .blockset.json blocksets they link",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/network/client.d.ts",
      "default": "./dist/network/client.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./server": {
      "types": "./dist/network/server.d.ts",
      "default": "./dist/network/server.js"
    },
    "./golem": {
      "types": "./dist/golem/index.d.ts",
      "default": "./dist/golem/index.js"
    }
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "jollypixel": {
    "golem": "./golem",
    "runtime": "./runtime",
    "sceneComponents": {
      "VoxelMap": {
        "assets": {
          "map": "voxelmap"
        }
      }
    }
  },
  "scripts": {
    "prepublishOnly": "rimraf ./dist ./tsconfig.tsbuildinfo && tsc -b",
    "build": "tsc -b && node -e \"fs.cpSync('src/golem/guide.md', 'dist/golem/guide.md')\"",
    "test-only": "node --test --test-isolation=none \"test/**/*.spec.ts\"",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit -p test/tsconfig.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/assets/voxel-map"
  },
  "keywords": [],
  "files": [
    "dist",
    "docs"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@jolly-pixel/asset": "workspace:*",
    "@jolly-pixel/asset-server": "workspace:*",
    "@jolly-pixel/asset.pixel-art": "workspace:*",
    "@jolly-pixel/backend.three": "workspace:*",
    "@jolly-pixel/golem.kit": "workspace:*",
    "@jolly-pixel/history": "workspace:*",
    "@jolly-pixel/network": "workspace:*",
    "@jolly-pixel/physics": "workspace:*",
    "@jolly-pixel/pixel-draw.renderer": "workspace:*",
    "@jolly-pixel/voxel.renderer": "workspace:*",
    "@openally/emitt": "1.1.0",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@jolly-pixel/asset-source": "workspace:*",
    "@jolly-pixel/asset.common": "workspace:*",
    "@jolly-pixel/ecs": "workspace:*",
    "@jolly-pixel/event-store": "workspace:*"
  }
}
