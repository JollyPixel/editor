{
  "name": "@jolly-pixel/asset.common",
  "description": "Code shared by the asset workspaces",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "build": "tsc -b",
    "test-only": "node --test --test-isolation=none \"test/**/*.spec.ts\"",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit -p test/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/assets/common"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "directories": {
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT"
}
