{
  "name": "@jolly-pixel/asset.script",
  "description": "Script assets",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/network/client.d.ts",
      "default": "./dist/network/client.js"
    }
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "build": "tsc -b",
    "test-only": "node --test --test-isolation=none \"test/**/*.spec.ts\"",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit -p test/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/assets/script"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "directories": {
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@jolly-pixel/asset-server": "workspace:*",
    "@jolly-pixel/network": "workspace:*",
    "@jolly-pixel/scripting": "workspace:*",
    "@openally/emitt": "1.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@jolly-pixel/asset": "workspace:*",
    "@jolly-pixel/event-store": "workspace:*",
    "es-module-lexer": "3.0.4",
    "fast-check": "4.10.2"
  }
}
