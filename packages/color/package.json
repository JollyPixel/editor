{
  "name": "@jolly-pixel/color",
  "description": "The color utilities for JollyPixel's editors",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prepublish": "rimraf ./dist && tsc -b",
    "build": "tsc",
    "typecheck": "tsc --noEmit -p test/tsconfig.json",
    "test-only": "node --test \"test/**/*.spec.ts\"",
    "test": "npm run typecheck && c8 -r html npm run test-only",
    "lint": "eslint \"src/**/*.ts\"",
    "bench": "jolly-bench"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/color"
  },
  "devDependencies": {
    "@jolly-pixel/bench": "*"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT"
}
