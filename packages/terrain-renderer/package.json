{
  "name": "@jolly-pixel/terrain.renderer",
  "description": "Jolly Pixel heightfield terrain engine and renderer",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/plugins/engine/index.d.ts",
      "default": "./dist/plugins/engine/index.js"
    }
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "build": "tsc -b",
    "test-only": "node --test --test-isolation=none \"test/**/*.spec.ts\"",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit -p test/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/terrain-renderer"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "author": "MALAJ Alexandre <alexandre.malaj@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "three": "0.186.1"
  },
  "peerDependencies": {
    "@jolly-pixel/engine": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@jolly-pixel/engine": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jolly-pixel/engine": "workspace:*"
  }
}
