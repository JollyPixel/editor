{
  "name": "@jolly-pixel/backend.three",
  "description": "three.js backend for the JollyPixel ECS: rendering, audio, assets, UI and the browser Runtime.",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsc -b && node scripts/copyAssets.ts",
    "bake:environment": "node scripts/bakeRoomEnvironment.ts",
    "test-only": "node --import ./test/setup.ts --test --test-isolation=none \"test/**/*.spec.ts\"",
    "test-gpu": "node --test test/systems/rendering/compositing/postProcessing.gpu.ts",
    "test-types": "tstyche --tsconfig ./test/tsconfig.json",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only && pnpm run test-types",
    "dev": "vite",
    "dev:e2e": "vite --config vite.e2e.config.ts",
    "test:e2e": "playwright test",
    "lint": "oxlint src test bench scripts examples",
    "bench": "jolly-bench",
    "typecheck": "tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p bench/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p examples/tsconfig.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/backend.three"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "directories": {
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@jolly-pixel/asset": "workspace:*",
    "@jolly-pixel/controls": "workspace:*",
    "@jolly-pixel/ecs": "workspace:*",
    "@jolly-pixel/loop": "workspace:*",
    "@jolly-pixel/runtime": "workspace:*",
    "@jolly-pixel/ui": "workspace:*",
    "@openally/emitt": "1.1.0"
  },
  "devDependencies": {
    "@jolly-pixel/bench": "workspace:*",
    "@jolly-pixel/e2e": "workspace:*"
  },
  "peerDependencies": {
    "three": "^0.187.0"
  }
}
