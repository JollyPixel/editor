{
  "name": "@jolly-pixel/server",
  "description": "JollyPixel server: a project's assets, accounts and HTTP API, and the contract its clients share",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p test/tsconfig.json",
    "test-only": "node --test \"test/**/*.spec.ts\"",
    "test": "pnpm run typecheck && c8 -r html pnpm run test-only",
    "lint": "oxlint src test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/server"
  },
  "keywords": [],
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@jolly-pixel/asset.voxel-model": "workspace:*",
    "@jolly-pixel/voxel.renderer": "workspace:*"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.1",
    "@jolly-pixel/accounts": "workspace:*",
    "@jolly-pixel/asset": "workspace:*",
    "@jolly-pixel/asset-server": "workspace:*",
    "@jolly-pixel/asset-source": "workspace:*",
    "@jolly-pixel/asset.voxel-map": "workspace:*",
    "@jolly-pixel/event-store": "workspace:*",
    "@jolly-pixel/network": "workspace:*",
    "@jolly-pixel/preferences": "workspace:*",
    "@openally/servo": "1.1.0",
    "cookie": "2.0.1",
    "fastify": "5.12.7",
    "fflate": "0.8.3",
    "zod": "4.6.7"
  }
}
