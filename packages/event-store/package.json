{
  "name": "@jolly-pixel/event-store",
  "description": "Append-only log for JollyPixel's events",
  "version": "2.0.0",
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/persistence/sqlite/index.d.ts",
      "default": "./dist/persistence/sqlite/index.js"
    }
  },
  "scripts": {
    "prepublish": "rimraf ./dist && tsc",
    "build": "tsc",
    "bench": "jolly-bench",
    "typecheck": "tsc --noEmit -p test/tsconfig.json",
    "test-only": "node --test \"test/**/*.spec.ts\"",
    "test-types": "tstyche --tsconfig ./test/tsconfig.json",
    "test": "npm run typecheck && c8 -r html npm run test-only && npm run test-types",
    "lint": "eslint src/**/*.ts"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JollyPixel/editor.git",
    "directory": "packages/event-store"
  },
  "keywords": [],
  "files": [
    "dist"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@openally/emitt": "1.0.1",
    "@openally/result": "3.1.0"
  },
  "devDependencies": {
    "@jolly-pixel/bench": "*"
  }
}
